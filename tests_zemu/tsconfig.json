{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@ledgerhq/hw-transport": ["node_modules/@ledgerhq/hw-transport"],
      "@ledgerhq/hw-transport/*": ["node_modules/@ledgerhq/hw-transport/*"],
      "@ledgerhq/logs": ["node_modules/@ledgerhq/logs"],
      "@ledgerhq/logs/*": ["node_modules/@ledgerhq/logs/*"]
    }
  },
  "exclude": ["node_modules", "./dist/**"]
}
